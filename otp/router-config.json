    { "type": "stop-time-updater",  "feedId": "krk-t", "frequency": "30s", "url": "https://gtfs.ztp.krakow.pl/TripUpdates_T.pb" },
    { "type": "vehicle-positions",  "feedId": "krk-a", "frequency": "30s", "url": "https://gtfs.ztp.krakow.pl/VehiclePositions_A.pb" },
    { "type": "vehicle-positions",  "feedId": "krk-t", "frequency": "30s", "url": "https://gtfs.ztp.krakow.pl/VehiclePositions_T.pb" },
    { "type": "real-time-alerts",   "feedId": "krk-a", "frequency": "5m",  "url": "https://gtfs.ztp.krakow.pl/ServiceAlerts_A.pb" },
    { "type": "real-time-alerts",   "feedId": "krk-t", "frequency": "5m",  "url": "https://gtfs.ztp.krakow.pl/ServiceAlerts_T.pb" },
    {
